<UserControl x:Class="VrcSetup_Desktop.PackageBrowserView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:VrcSetup_Desktop">
    <UserControl.Resources><local:LocalizedTextConverter x:Key="Localize"/>
        <Style x:Key="QuietButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Foreground" Value="{ThemeResource AppAccentTextBrush}"/><Setter Property="Background" Value="{ThemeResource AppAccentSubtleBrush}"/><Setter Property="Padding" Value="10,5"/></Style>
        <Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8" Margin="0,4,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox PlaceholderText="{local:Loc Key='Search local and online packages'}" Text="{Binding LibraryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:Loc Key='Search packages'}"/>
            <ProgressRing Width="18" Height="18" IsActive="{Binding IsSearchingPackages}" HorizontalAlignment="Right" Margin="0,0,12,0"/>
            <ToggleButton Grid.Column="1" IsChecked="{Binding FavoritesOnly, Mode=TwoWay}" Content="★" Width="36" ToolTipService.ToolTip="{local:Loc Key='Favorites only'}" AutomationProperties.Name="{local:Loc Key='Favorites only'}"/>
            <Button Grid.Column="2" Command="{Binding ToggleLibraryLayoutCommand}" Style="{StaticResource QuietButton}" ToolTipService.ToolTip="{Binding LibraryLayoutAction}" AutomationProperties.Name="{Binding LibraryLayoutAction}"><FontIcon Glyph="{Binding LibraryLayoutGlyph}" FontSize="18"/></Button>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,10"><TextBlock  Text="{Binding CatalogNotice, Converter={StaticResource Localize}}" Visibility="{Binding CatalogNoticeVisibility}" Foreground="{ThemeResource AppSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/><TextBlock Text="{Binding WorkspaceFriendlySummary}" Visibility="{Binding LibraryPendingVisibility}" Foreground="{ThemeResource AppAccentTextBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkspaceFriendlyNames}" Visibility="{Binding LibraryPendingVisibility}" Foreground="{ThemeResource AppSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
        <GridView x:Name="LibraryCards" Grid.Row="2" ItemsSource="{Binding LibraryPackages}" SelectionMode="None" Visibility="{Binding LibraryGridVisibility}" SizeChanged="CardsSizeChanged">
            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="260" ItemHeight="144"/></ItemsPanelTemplate></GridView.ItemsPanel>
            <GridView.ItemTemplate><DataTemplate>
                <Border Margin="0,0,12,12" Padding="12" CornerRadius="6" Background="{ThemeResource AppSurfaceBrush}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/><TextBlock Text="{Binding Id}" FontSize="11" Foreground="{ThemeResource AppSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Id}"/></StackPanel>
                        <Grid Grid.Row="1" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Content="{Binding AddLabel, Converter={StaticResource Localize}}" Click="LibraryAddClicked" Visibility="{Binding AddVisibility}" Style="{StaticResource AddButton}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding IncludedLabel, Converter={StaticResource Localize}}" Visibility="{Binding IncludedVisibility}" VerticalAlignment="Center" Foreground="{ThemeResource AppAccentTextBrush}"/>
                            <Button Grid.Column="1" Click="PackageStarClicked" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding FavoriteAction}"><FontIcon Glyph="{Binding StarGlyph}" Foreground="{Binding StarBrush}" FontSize="16"/></Button>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate></GridView.ItemTemplate>
        </GridView>
        <ListView x:Name="LibraryList" Grid.Row="2" ItemsSource="{Binding LibraryPackages}" SelectionMode="None" Visibility="{Binding LibraryListVisibility}">
            <ListView.ItemTemplate><DataTemplate>
                <Grid Padding="10,10" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Id}" FontSize="11" Foreground="{ThemeResource AppSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Id}"/></StackPanel>
                    <Button Grid.Column="1" Content="{Binding AddLabel, Converter={StaticResource Localize}}" Click="LibraryAddClicked" Visibility="{Binding AddVisibility}" Style="{StaticResource AddButton}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding IncludedLabel, Converter={StaticResource Localize}}" Visibility="{Binding IncludedVisibility}" VerticalAlignment="Center" Foreground="{ThemeResource AppAccentTextBrush}"/>
                    <Button Grid.Column="2" Click="PackageStarClicked" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding FavoriteAction}"><FontIcon Glyph="{Binding StarGlyph}" Foreground="{Binding StarBrush}" FontSize="16"/></Button>
                </Grid>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

<UserControl x:Class="VrcSetup_Desktop.PackageBrowserView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:VrcSetup_Desktop">
    <UserControl.Resources><local:LocalizedTextConverter x:Key="Localize"/>
        <Style x:Key="QuietButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Foreground" Value="{ThemeResource AppAccentTextBrush}"/><Setter Property="Background" Value="{ThemeResource AppAccentSubtleBrush}"/><Setter Property="Padding" Value="10,5"/></Style>
        <Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinWidth" Value="0"/></Style>
        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="MinWidth" Value="0"/></Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="SearchToolbar" ColumnSpacing="8" Margin="0,4,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox PlaceholderText="{local:Loc Key='Search local and online packages'}" Text="{Binding LibraryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:Loc Key='Search packages'}"/>
            <ProgressRing Width="18" Height="18" IsActive="{Binding IsSearchingPackages}" HorizontalAlignment="Right" Margin="0,0,12,0"/>
            <ToggleButton Grid.Column="1" IsChecked="{Binding FavoritesOnly, Mode=TwoWay}" Content="★" Width="36" ToolTipService.ToolTip="{local:Loc Key='Favorites only'}" AutomationProperties.Name="{local:Loc Key='Favorites only'}"/>
            <Button Grid.Column="2" Command="{Binding ToggleLibraryLayoutCommand}" Style="{StaticResource QuietButton}" ToolTipService.ToolTip="{Binding LibraryLayoutAction}" AutomationProperties.Name="{Binding LibraryLayoutAction}"><FontIcon Glyph="{Binding LibraryLayoutGlyph}" FontSize="18"/></Button>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Padding="12,32" Visibility="{Binding CatalogNoticeVisibility}"><ProgressRing Width="20" Height="20" IsActive="{Binding IsSearchingPackages}"/><TextBlock Text="{Binding CatalogStatusText, Converter={StaticResource Localize}}" Foreground="{ThemeResource AppSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
        <GridView x:Name="LibraryCards" Grid.Row="2" ItemsSource="{Binding LibraryPackages}" SelectionMode="None" Visibility="{Binding LibraryGridVisibility}" SizeChanged="CardsSizeChanged">
            <GridView.ItemContainerTransitions><TransitionCollection><RepositionThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></GridView.ItemContainerTransitions>
            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="260" ItemHeight="128"/></ItemsPanelTemplate></GridView.ItemsPanel>
            <GridView.ItemTemplate><DataTemplate>
                <Grid Style="{StaticResource PackageRowSurface}" Margin="0,0,4,4" Padding="10">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7B8;" FontSize="17" Foreground="{ThemeResource AppSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxLines="2"/><TextBlock Text="{Binding Id}" FontSize="11" Foreground="{ThemeResource AppSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Id}"/></StackPanel></Grid>
                        <Grid Grid.Row="1" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Button Click="LibraryAddClicked" Visibility="{Binding AddVisibility}" Style="{StaticResource AddButton}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding AddLabel, Converter={StaticResource Localize}}"><StackPanel Orientation="Horizontal" Spacing="7"><local:PackageActionIcon IsAdd="{Binding CanAdd}" Foreground="{ThemeResource AppAccentTextBrush}"/><TextBlock Text="{Binding AddLabel, Converter={StaticResource Localize}}" VerticalAlignment="Center"/></StackPanel></Button>
                            <TextBlock Text="{Binding IncludedLabel, Converter={StaticResource Localize}}" Visibility="{Binding IncludedVisibility}" VerticalAlignment="Center" Foreground="{ThemeResource AppAccentTextBrush}"/>
                            <Button Grid.Column="1" Click="PackageStarClicked" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding FavoriteAction}"><FontIcon Glyph="{Binding StarGlyph}" Foreground="{Binding StarBrush}" FontSize="16"/></Button>
                        </Grid>
                    </Grid>
                </Grid>
            </DataTemplate></GridView.ItemTemplate>
        </GridView>
        <ListView x:Name="LibraryList" Grid.Row="2" ItemsSource="{Binding LibraryPackages}" SelectionMode="None" Visibility="{Binding LibraryListVisibility}">
            <ListView.ItemContainerTransitions><TransitionCollection><RepositionThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></ListView.ItemContainerTransitions>
            <ListView.ItemTemplate><DataTemplate>
                <Grid Style="{StaticResource PackageRowSurface}" Padding="12,7" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center" MinWidth="0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Id}" FontSize="11" Foreground="{ThemeResource AppSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Id}"/></StackPanel>
                    <Button Grid.Column="1" Click="LibraryAddClicked" Visibility="{Binding AddVisibility}" Style="{StaticResource AddButton}" VerticalAlignment="Center" AutomationProperties.Name="{Binding AddLabel, Converter={StaticResource Localize}}"><StackPanel Orientation="Horizontal" Spacing="7"><local:PackageActionIcon IsAdd="{Binding CanAdd}" Foreground="{ThemeResource AppAccentTextBrush}"/><TextBlock Text="{Binding AddLabel, Converter={StaticResource Localize}}" VerticalAlignment="Center"/></StackPanel></Button>
                    <TextBlock Grid.Column="1" Text="{Binding IncludedLabel, Converter={StaticResource Localize}}" Visibility="{Binding IncludedVisibility}" VerticalAlignment="Center" Foreground="{ThemeResource AppAccentTextBrush}"/>
                    <Button Grid.Column="2" Click="PackageStarClicked" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding FavoriteAction}"><FontIcon Glyph="{Binding StarGlyph}" Foreground="{Binding StarBrush}" FontSize="16"/></Button>
                </Grid>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

<Page
    x:Class="VrcSetup_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VrcSetup_Desktop">
    <Page.Resources><local:LocalizedTextConverter x:Key="Localize"/>
        <local:DisplayLabelConverter x:Key="DisplayLabel"/>
        <local:PackageRowConverter x:Key="PackageRow"/>
        <local:ProjectAttentionConverter x:Key="ProjectAttention"/>
        <local:ProjectDateConverter x:Key="ProjectDate"/>
        <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="48"/></Style>
        <Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style TargetType="Expander"><Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style x:Key="QuietButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}"/>
        <DataTemplate x:Key="PresetChoice"><TextBlock Text="{Binding Converter={StaticResource DisplayLabel}}"/></DataTemplate>
        <DataTemplate x:Key="HistoryEntryTemplate">
            <Expander IsExpanded="{Binding Expanded, Mode=TwoWay}" Margin="0,0,0,6" Background="Transparent" BorderThickness="0,0,0,1">
                <Expander.Header><Grid ColumnSpacing="16" RowSpacing="5" Padding="0,4" Loaded="HistoryHeaderLoaded" SizeChanged="HistoryHeaderResized"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding StateCaption}" FontSize="12" Foreground="{ThemeResource AppAccentTextBrush}"/><TextBlock x:Name="HistoryDate" Grid.Column="2" Text="{Binding Date}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/><TextBlock x:Name="HistorySummary" Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Summary, Converter={StaticResource Localize}}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"/></Grid></Expander.Header>
                <StackPanel Spacing="12"><TextBlock Text="{Binding Result, Converter={StaticResource Localize}}" Visibility="{Binding ResultVisibility}" TextWrapping="Wrap"/><TextBlock Text="{Binding Health, Converter={StaticResource Localize}}" Visibility="{Binding HealthVisibility}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource AppSecondaryBrush}"/>
                    <TextBlock Text="{Binding Packages}" Visibility="{Binding PackagesVisibility}" TextWrapping="Wrap" FontSize="13"/>
                    <Expander Header="{local:Loc Key='Planned changes'}" Visibility="{Binding ChangesVisibility}" Background="Transparent" BorderThickness="0"><TextBlock Text="{Binding Changes}" TextWrapping="Wrap" FontSize="13"/></Expander>
                    <Expander Header="{local:Loc Key='File locations'}" Background="Transparent" BorderThickness="0"><TextBlock Text="{Binding Paths}" FontSize="12" Foreground="{ThemeResource AppSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding ImportActionsVisibility}"><Button Content="{local:Loc Key='Check project'}" Click="HistoryCheckClicked" IsEnabled="{Binding CanCheck}" Style="{StaticResource QuietButton}" FontSize="12" Padding="8,4" MinHeight="28"/><Button Content="{Binding RepairLabel, Converter={StaticResource Localize}}" Click="HistoryRepairClicked" IsEnabled="{Binding CanCheck}" Style="{StaticResource QuietButton}" FontSize="12" Padding="8,4" MinHeight="28"/></StackPanel>
                    <Button Content="{local:Loc Key='Restore backup'}" Click="HistoryRestoreClicked" Visibility="{Binding RestoreVisibility}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" FontSize="12" Padding="8,4" MinHeight="28"/>
                    <Button Content="{local:Loc Key='Show project folder'}" Click="HistoryProjectClicked" Visibility="{Binding ProjectActionsVisibility}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/><Button Content="{local:Loc Key='Open log'}" Click="HistoryLogClicked" IsEnabled="{Binding HasLog}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" FontSize="12" Padding="8,4" MinHeight="28"/></StackPanel>
            </Expander>
        </DataTemplate>
    </Page.Resources>
    <Grid Background="{ThemeResource AppCanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <InfoBar IsOpen="{Binding IsErrorVisible}" Message="{Binding ErrorMessage}" Title="" Severity="Error" IsClosable="True" Closed="ErrorClosed" Margin="12,8"><InfoBar.ActionButton><Button Content="{local:Loc Key='Contact support'}" Command="{Binding ContactSupportCommand}"/></InfoBar.ActionButton></InfoBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsEnabled="{Binding MainInteractionEnabled}" IsBackButtonVisible="Collapsed" PaneDisplayMode="LeftCompact" OpenPaneLength="180" ExpandedModeThresholdWidth="900" CompactModeThresholdWidth="0"
                        IsSettingsVisible="False" ItemInvoked="NavigationInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{local:Loc Key='Projects'}" Tag="Projects" Icon="Library"/>
                <NavigationViewItem Content="{local:Loc Key='Import projects'}" Tag="Create" Icon="Add"/>
                <NavigationViewItem Content="{local:Loc Key='Packages'}" Tag="Presets" Icon="AllApps"/>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel HorizontalAlignment="Stretch">
                    <Button x:Name="ActivityNavigationItem" Click="ActivityClicked" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,2,4,2" Padding="12,8" AutomationProperties.Name="{local:Loc Key='Activity'}" ToolTipService.ToolTip="{local:Loc Key='Activity'}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="ActivityNavigationMarker" Width="3" Height="16" HorizontalAlignment="Left" Margin="-10,0,0,0" CornerRadius="1" Background="{ThemeResource AppAccentTextBrush}" Visibility="Collapsed"/><FontIcon Glyph="&#xE81C;" FontSize="16"/><TextBlock x:Name="ActivityNavigationLabel" Grid.Column="1" Text="{local:Loc Key='Activity'}" FontSize="14" VerticalAlignment="Center"/></Grid></Button>
                    <Button x:Name="SettingsNavigationItem" Click="SettingsClicked" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,2,4,2" Padding="12,8" AutomationProperties.Name="{local:Loc Key='Settings'}" ToolTipService.ToolTip="{local:Loc Key='Settings'}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="SettingsNavigationMarker" Width="3" Height="16" HorizontalAlignment="Left" Margin="-10,0,0,0" CornerRadius="1" Background="{ThemeResource AppAccentTextBrush}" Visibility="Collapsed"/><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock x:Name="SettingsNavigationLabel" Grid.Column="1" Text="{local:Loc Key='Settings'}" FontSize="14" VerticalAlignment="Center"/></Grid></Button>
                <Grid x:Name="InformationPanel" Visibility="Collapsed" Margin="4,0">
                    <Border x:Name="InformationSurface" Height="0" Background="{ThemeResource AppSurfaceBrush}" CornerRadius="6" SizeChanged="InformationSurfaceResized">
                        <StackPanel x:Name="InformationLinks" Padding="4" Spacing="2">
                            <Button x:Name="InfoReleases" Command="{Binding OpenReleasesCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" Padding="10,8" Content="{local:Loc Key='Releases and downloads'}"/>
                            <Button x:Name="InfoBug" Command="{Binding ReportBugCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" Padding="10,8" Content="{local:Loc Key='Report a bug'}"/>
                            <Button x:Name="InfoContact" Command="{Binding ContactSupportCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" Padding="10,8"><TextBlock Text="contact@dummics.com" TextTrimming="CharacterEllipsis"/></Button>
                            <Button x:Name="InfoLogs" Command="{Binding OpenLogsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12" Padding="10,8" Content="{local:Loc Key='Open logs'}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                    <Button x:Name="InformationItem" Click="InformationClicked" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,2,4,4" Padding="12,8" AutomationProperties.Name="{local:Loc Key='Information'}" ToolTipService.ToolTip="{local:Loc Key='Information'}">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE946;" FontSize="16"/><TextBlock x:Name="InformationLabel" Text="{local:Loc Key='Information'}" FontSize="14" VerticalAlignment="Center"/></StackPanel>
                        <FlyoutBase.AttachedFlyout><MenuFlyout Placement="Top"><MenuFlyoutItem Text="{local:Loc Key='Releases and downloads'}" Command="{Binding OpenReleasesCommand}"/><MenuFlyoutItem Text="{local:Loc Key='Report a bug'}" Command="{Binding ReportBugCommand}"/><MenuFlyoutItem Text="contact@dummics.com" Command="{Binding ContactSupportCommand}"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="{local:Loc Key='Open logs'}" Command="{Binding OpenLogsCommand}"/></MenuFlyout></FlyoutBase.AttachedFlyout>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid x:Name="PageContent" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1,0,0,0" Padding="24,20" Background="{ThemeResource AppCanvasBrush}">
                <Grid x:Name="ProjectsView">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid x:Name="ProjectsHeader" ColumnSpacing="12" RowSpacing="12" Padding="0,0,0,18" Margin="0,0,0,18" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="0,0,0,1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{local:Loc Key='Projects'}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/><Button Command="{Binding OpenProjectsFolderCommand}" Style="{StaticResource QuietButton}" ToolTipService.ToolTip="Open projects folder" AutomationProperties.Name="Open projects folder"><FontIcon Glyph="&#xE8B7;" FontSize="16"/></Button></StackPanel>
                        <StackPanel x:Name="ProjectHeaderActions" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"><Button Content="{local:Loc Key='Add existing'}" Command="{Binding PickExistingProjectCommand}" Style="{StaticResource QuietButton}" FontSize="13" MinHeight="32"/><Button Content="{local:Loc Key='New project'}" Click="NewProjectClicked" FontSize="13" MinHeight="32" Padding="10,5"/></StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,8">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid x:Name="ProjectSearch" ColumnSpacing="6" HorizontalAlignment="Left" Width="320" MaxWidth="440">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="{local:Loc Key='Search projects'}" Text="{Binding ProjectFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:Loc Key='Search projects'}"/>
                        <Button Grid.Column="1" Command="{Binding RefreshProjectsCommand}" Style="{StaticResource QuietButton}" Width="36" ToolTipService.ToolTip="{local:Loc Key='Refresh'}" AutomationProperties.Name="{local:Loc Key='Refresh'}"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
                    </Grid>
<Button x:Name="ManageSelectionAction" SizeChanged="ManageSelectionResized" Grid.Column="1" Content="{Binding ManageSelectionLabel, Converter={StaticResource Localize}}" Visibility="{Binding ManageSelectionVisibility}" Command="{Binding OpenSelectedProjectsCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid x:Name="ProjectColumnHeaders" Padding="24,0,42,0" ColumnSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
<Button Content="{Binding ProjectNameSortLabel}" Tag="name" Click="ProjectSortClicked" Style="{StaticResource QuietButton}" Padding="0" HorizontalAlignment="Left" FontSize="12"/>
                        <Grid x:Name="ProjectDateSortHeader" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Button Content="{Binding ProjectModifiedSortLabel}" Tag="modified" Click="ProjectSortClicked" Style="{StaticResource QuietButton}" Padding="0" FontSize="12"/><Button Grid.Column="1" Content="{Binding ProjectCreatedSortLabel}" Tag="created" Click="ProjectSortClicked" Style="{StaticResource QuietButton}" Padding="0" FontSize="12"/></Grid>
                    </Grid>
                    </StackPanel>
                    <ListView x:Name="ProjectList" Grid.Row="2" ItemsSource="{Binding Projects}" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="False" SelectionChanged="ProjectsSelected">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="56"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Margin" Value="0,2"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate>
                            <Grid Style="{StaticResource PackageRowSurface}" Padding="10,8" Margin="0,0,0,2" ColumnSpacing="16" RowSpacing="8" Loaded="ProjectRowLoaded" SizeChanged="ProjectRowSizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:ProjectSelectionIndicator AutomationProperties.Name="{Binding Name}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
                                <Grid x:Name="ProjectDates" Grid.Column="1" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock x:Name="ProjectModified" Text="{Binding LastUpdatedUtc, Converter={StaticResource ProjectDate}}" FontSize="12" Opacity="0.7" ToolTipService.ToolTip="{Binding LastUpdatedUtc, Converter={StaticResource ProjectDate}, ConverterParameter=Full}"/><TextBlock Grid.Column="1" Text="{Binding CreatedUtc, Converter={StaticResource ProjectDate}}" FontSize="12" Opacity="0.7" ToolTipService.ToolTip="{Binding CreatedUtc, Converter={StaticResource ProjectDate}, ConverterParameter=Full}"/></Grid>
                                <StackPanel x:Name="ProjectActions" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="#E8B55B" Visibility="{Binding Converter={StaticResource ProjectAttention}}" ToolTipService.ToolTip="{Binding Converter={StaticResource ProjectAttention}, ConverterParameter=Label}" AutomationProperties.Name="{Binding Converter={StaticResource ProjectAttention}, ConverterParameter=Label}"/><Button Content="{local:Loc Key='Open'}" Click="ProjectOpenClicked" Padding="12,5" MinHeight="32"/><Button Click="ProjectPackagesClicked" Style="{StaticResource QuietButton}" ToolTipService.ToolTip="{local:Loc Key='Manage packages'}" AutomationProperties.Name="{local:Loc Key='Manage packages'}"><FontIcon Glyph="&#xE7B8;" FontSize="18"/></Button></StackPanel>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Visibility="{Binding EmptyProjectsVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="460"><FontIcon Glyph="&#xE8B7;" FontSize="40" Opacity="0.55"/><TextBlock Text="{Binding EmptyProjectsMessage, Converter={StaticResource Localize}}" TextWrapping="Wrap" TextAlignment="Center"/><Button Content="{local:Loc Key='Choose projects folder'}" Command="{Binding PickProjectsRootCommand}" HorizontalAlignment="Center"/></StackPanel>
                    <ProgressRing Grid.Row="2" IsActive="{Binding IsLoadingProjects}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer x:Name="CreateView" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AllowDrop="True" DragOver="PackageDragOver" Drop="ImportFilesDropped">
                    <Grid x:Name="CreateLayout" RowSpacing="12" HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid x:Name="ImportPageHeader" ColumnSpacing="12" RowSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{local:Loc Key='Import projects'}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/><TextBlock x:Name="ImportResourceSummary" Grid.Column="1" Text="{Binding ResourceSummary}" FontSize="12" Opacity="0.65" HorizontalAlignment="Right" VerticalAlignment="Center"/><Button Grid.Column="2" Style="{StaticResource QuietButton}" AutomationProperties.Name="Import options"><FontIcon Glyph="&#xE712;"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{local:Loc Key='Open logs'}" Command="{Binding OpenLogsCommand}"/><MenuFlyoutItem Text="{local:Loc Key='Open project folders'}" Command="{Binding OpenProjectsFolderCommand}"/></MenuFlyout></Button.Flyout></Button></Grid>
                    <StackPanel x:Name="CreateForm" Grid.Row="1" HorizontalAlignment="Left" Spacing="12">
                        <Border x:Name="PackageDropZone" AllowDrop="True" DragOver="PackageDragOver" Drop="PackageDropped" DragLeave="PackageDragLeave" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16" MinHeight="76">
                            <Grid x:Name="DropLayout" ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="#51CEBD"/><TextBlock x:Name="DropFileLabel" Grid.Column="1" Text="{Binding PackageFileLabel, Converter={StaticResource Localize}}" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding PackageFile}"/><Button x:Name="ChoosePackageButton" Grid.Column="2" Content="{local:Loc Key='Choose files'}" Click="ImportFilesClicked" VerticalAlignment="Center"/></Grid>
                        </Border>
                        <StackPanel Visibility="{Binding EditorSetupVisibility}" Spacing="6"><TextBlock Text="{local:Loc Key='Unity 2022.3.22f1 is required'}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{local:Loc Key='Find Unity'}" Command="{Binding FindEditorCommand}"/><Button Content="{local:Loc Key='Install Unity'}" Command="{Binding OpenUnityDownloadCommand}" Style="{StaticResource QuietButton}"/></StackPanel></StackPanel><ListView ItemsSource="{Binding ImportDrafts}" SelectedItem="{Binding SelectedImportDraft, Mode=TwoWay}" SelectionMode="Single" Visibility="{Binding DraftListVisibility}" MaxHeight="160" HorizontalAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" Padding="8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding File}"/><Button Grid.Column="1" Style="{StaticResource QuietButton}" Click="RemoveImportDraftClicked" AutomationProperties.Name="Remove selected file"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                        <Grid x:Name="ProjectFields" MaxWidth="620" HorizontalAlignment="Left" ColumnSpacing="12" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox Header="{local:Loc Key='Project name'}" PlaceholderText="{local:Loc Key='Generated from the file name'}" Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox x:Name="PlatformSelector" Grid.Column="1" Header="{local:Loc Key='Platform'}" ItemsSource="{Binding PlatformOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding BuildTarget, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <TextBlock Text="{Binding DestinationPreview}" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DestinationPreview}"/>
                        <Grid x:Name="PackageSetup" ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid x:Name="PresetFields" HorizontalAlignment="Left" ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ComboBox x:Name="CreationPresetSelector" Header="{local:Loc Key='Preset'}" ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetChoice}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" HorizontalAlignment="Stretch"/><Button x:Name="CustomizePackagesButton" Grid.Column="1" Content="{local:Loc Key='Customize'}" ToolTipService.ToolTip="Customize packages for this import" Command="{Binding CustomizeCreationPackagesCommand}" VerticalAlignment="Bottom"/></Grid>
                            <StackPanel x:Name="ReviewAction" Grid.Column="1" HorizontalAlignment="Right" Spacing="6" MaxWidth="260" VerticalAlignment="Bottom"><TextBlock Text="{Binding ImportError, Converter={StaticResource Localize}}" Height="36" MaxLines="2" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SystemFillColorCriticalBrush}" ToolTipService.ToolTip="{Binding ImportError}"/><Button Content="{local:Loc Key='Settings'}" Click="ImportSettingsClicked" Style="{StaticResource QuietButton}" Visibility="{Binding ImportSettingsVisibility}" HorizontalAlignment="Right"/><Button Content="{Binding ImportReviewLabel, Converter={StaticResource Localize}}" Command="{Binding CreateProjectCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Right"/></StackPanel>
                            <Expander x:Name="CreationPackageDetails" Grid.Row="1" Grid.ColumnSpan="2" IsExpanded="False" Expanding="CreationPackagesExpanded" Collapsed="CreationPackagesCollapsed" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Background="{ThemeResource AppSurfaceBrush}" BorderThickness="0" Padding="12,4,12,8" CornerRadius="6" MinWidth="0" MinHeight="36">
                                <Expander.Resources><StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="AppSurfaceBrush"/><SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/><Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness><Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness><Thickness x:Key="ExpanderContentUpBorderThickness">0</Thickness><Thickness x:Key="ExpanderHeaderPadding">12,0,0,0</Thickness><x:Double x:Key="ExpanderMinHeight">36</x:Double></Expander.Resources>
                                <Expander.Header><TextBlock x:Name="CreationPackageHeader" Text="{Binding CreationPackageSummary}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding InspectionStatus}" Loaded="CreationPackagesLoaded"/></Expander.Header>
                                <StackPanel Spacing="4">
                                <GridView x:Name="CreationPackageList" ItemsSource="{Binding CreationPackages}" SelectionMode="None" IsItemClickEnabled="False" Loaded="CreationPackagesLoaded" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <GridView.ItemContainerTransitions><TransitionCollection><RepositionThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></GridView.ItemContainerTransitions>
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemHeight="36"/></ItemsPanelTemplate></GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,4,3"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/></Style></GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate><DataTemplate><Grid Style="{StaticResource PackageRowSurface}" ColumnSpacing="8" Padding="8,2" ToolTipService.ToolTip="{Binding Tooltip}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Version}" Visibility="{Binding PinVisibility}" FontSize="11" Opacity="0.65" MaxWidth="100" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="2" Content="{Binding Action, Converter={StaticResource Localize}}" Visibility="{Binding ActionVisibility}" Click="AddCreationSuggestionClicked" Style="{StaticResource QuietButton}" FontSize="12" MinHeight="28" Padding="8,4" VerticalAlignment="Center"/></Grid></DataTemplate></GridView.ItemTemplate>
                                </GridView>
                                </StackPanel>
                            </Expander>
                        </Grid>
                        <TextBox Header="{local:Loc Key='UnityPackage path'}" Text="{Binding PackageFile, Mode=TwoWay}" Visibility="{Binding ManualImportPathVisibility}"/>
                    </StackPanel>
                    <StackPanel x:Name="ImportQueueSection" Grid.Row="2" VerticalAlignment="Bottom" Spacing="8" HorizontalAlignment="Left" Visibility="{Binding ImportJobsVisibility}">
                        <StackPanel.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="False"/></TransitionCollection></StackPanel.Transitions>
                        <Button HorizontalAlignment="Right" Command="{Binding ClearImportHistoryCommand}" Visibility="{Binding ClearCompletedVisibility}" Style="{StaticResource QuietButton}" MinHeight="28" Padding="8,4" ToolTipService.ToolTip="Hide completed imports; keep their Activity history"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="10"/><TextBlock Text="{local:Loc Key='Clear completed'}" FontSize="12"/></StackPanel></Button>
<ListView x:Name="ImportQueueList" ItemsSource="{Binding ImportJobs}" Visibility="{Binding ImportJobsVisibility}" SelectionMode="None" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListView.Resources><SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/></ListView.Resources><ListView.ItemContainerTransitions><TransitionCollection><RepositionThemeTransition/></TransitionCollection></ListView.ItemContainerTransitions><ListView.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0" Padding="0,2">

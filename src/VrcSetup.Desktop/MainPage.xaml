                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Visibility="{Binding SettingsChangesVisibility}" Padding="0,12,24,0"><Button Content="{local:Loc Key='Discard'}" Command="{Binding DiscardSettingsCommand}" Style="{StaticResource QuietButton}"/><Button Content="{Binding SettingsSaveLabel, Converter={StaticResource Localize}}" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding ImportsIdle}" Style="{StaticResource ActionButton}"/></StackPanel>
                </Grid>

            </Grid>
        </NavigationView>

        <Grid x:Name="StatusBar" Grid.Row="3" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="0,1,0,0" Padding="12,4" MinHeight="38" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ProgressBar x:Name="ApplicationProgress" Width="72" Height="3" VerticalAlignment="Center" IsIndeterminate="{Binding ApplicationProgressIndeterminate}" Value="{Binding UpdateDownloadPercent}" Maximum="100" Visibility="{Binding ApplicationProgressVisibility}" AutomationProperties.Name="{local:Loc Key='Application status'}"/>
                <Button Grid.Column="1" Command="{Binding OpenApplicationStatusCommand}" IsEnabled="{Binding MainInteractionEnabled}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="4,2" MinHeight="28" Visibility="{Binding ApplicationStatusVisibility}"><TextBlock x:Name="ApplicationStatusText" Text="{Binding ApplicationStatus}" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></Button>
                <Button Grid.Column="2" Content="{local:Loc Key='Stop'}" Command="{Binding CancelOperationCommand}" Style="{StaticResource QuietButton}" FontSize="12" MinHeight="28" Padding="8,2" Visibility="{Binding ApplicationStopVisibility}"/>
            </Grid>
            <Button x:Name="ApplicationVersionButton" Grid.Column="1" Content="{Binding UpdateLabel, Converter={StaticResource Localize}}" Command="{Binding UpdateActionCommand}" IsEnabled="{Binding CanUseUpdateAction}" Style="{StaticResource QuietButton}" FontSize="11" Padding="8,2" MinHeight="28" AutomationProperties.Name="Application version and updates">
                
            </Button>
        </Grid>
        <Grid Grid.RowSpan="3" Background="#99000000" Visibility="{Binding ApplyOverlayVisibility}" AutomationProperties.Name="Applying package changes">
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="24" MaxWidth="460" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16"><TextBlock Text="{local:Loc Key='Applying changes'}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding ApplyProject}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding ApplyPosition, Converter={StaticResource Localize}}" FontSize="12" Opacity="0.65"/><ProgressBar IsIndeterminate="True" MinWidth="200"/><TextBlock Text="{Binding ApplyPhase, Converter={StaticResource Localize}}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><Button Content="{local:Loc Key='Cancel'}" Command="{Binding CancelApplyCommand}" IsEnabled="{Binding CanCancelApply}" HorizontalAlignment="Right" Style="{StaticResource QuietButton}"/></StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

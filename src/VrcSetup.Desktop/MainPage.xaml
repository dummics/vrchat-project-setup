<Page
    x:Class="VrcSetup_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VrcSetup_Desktop">
    <Page.Resources>
        <local:DisplayLabelConverter x:Key="DisplayLabel"/>
        <local:PackageRowConverter x:Key="PackageRow"/>
        <local:ProjectAttentionConverter x:Key="ProjectAttention"/>
        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="56"/></Style>
        <Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style TargetType="Expander"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style x:Key="QuietButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="Background" Value="#51CEBD"/><Setter Property="Foreground" Value="#102B29"/><Setter Property="Padding" Value="18,10"/></Style>
        <DataTemplate x:Key="PresetChoice"><TextBlock Text="{Binding Converter={StaticResource DisplayLabel}}"/></DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <InfoBar IsOpen="{Binding IsErrorVisible}" Message="{Binding ErrorMessage}" Title="" Severity="Error" IsClosable="True" Closed="ErrorClosed" Margin="12,8"/>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" PaneDisplayMode="Auto" OpenPaneLength="220" ExpandedModeThresholdWidth="1000" CompactModeThresholdWidth="640"
                        IsSettingsVisible="True" ItemInvoked="NavigationInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Projects" Tag="Projects" Icon="Library"/>
                <NavigationViewItem Content="Create project" Tag="Create" Icon="Add"/>
                <NavigationViewItem Content="Packages" Tag="Presets" Icon="AllApps"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems><NavigationViewItem Content="Activity" Tag="Activity" Icon="Clock"/></NavigationView.FooterMenuItems>
            <Grid x:Name="PageContent" Padding="28,24">
                <Grid x:Name="ProjectsView">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Projects" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Add existing" Command="{Binding PickExistingProjectCommand}"/>
                        <Button Grid.Column="2" Content="New project" Style="{StaticResource ActionButton}" Click="NewProjectClicked"/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="Search projects" Text="{Binding ProjectFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search projects"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding ProjectSort, Mode=TwoWay}" SelectionChanged="SortChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Project sort order"/>
                        <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshProjectsCommand}"/>
                    </Grid>
                    <ListView x:Name="ProjectList" Grid.Row="2" ItemsSource="{Binding Projects}" SelectionMode="Multiple" SelectionChanged="ProjectsSelected" IsItemClickEnabled="True" ItemClick="ProjectClicked">
                        <ListView.ItemTemplate><DataTemplate>
                            <Grid Padding="14,12" ColumnSpacing="20" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Kind}"/><TextBlock Text="{Binding UnityVersion}" FontSize="12" Opacity="0.65"/></StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="#E8B55B" Visibility="{Binding Converter={StaticResource ProjectAttention}}" ToolTipService.ToolTip="{Binding Converter={StaticResource ProjectAttention}, ConverterParameter=Label}" AutomationProperties.Name="{Binding Converter={StaticResource ProjectAttention}, ConverterParameter=Label}"/><Button Click="ProjectPackagesClicked" Style="{StaticResource QuietButton}" ToolTipService.ToolTip="Manage packages" AutomationProperties.Name="Manage project packages"><FontIcon Glyph="&#xE7B8;" FontSize="18"/></Button></StackPanel>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Visibility="{Binding EmptyProjectsVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="460"><FontIcon Glyph="&#xE8B7;" FontSize="40" Opacity="0.55"/><TextBlock Text="{Binding EmptyProjectsMessage}" TextWrapping="Wrap" TextAlignment="Center"/><Button Content="Choose projects folder" Command="{Binding PickProjectsRootCommand}" HorizontalAlignment="Center"/></StackPanel>
                    <ProgressRing Grid.Row="2" IsActive="{Binding IsLoadingProjects}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Row="3" Content="Open selected projects" IsEnabled="{Binding HasSelectedProjects}" Command="{Binding OpenSelectedProjectsCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
                </Grid>

                <ScrollViewer x:Name="CreateView" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="CreateForm" MaxWidth="760" HorizontalAlignment="Left" Spacing="22">
                        <TextBlock Text="Create project" Style="{StaticResource TitleTextBlockStyle}"/>
                        <Border x:Name="PackageDropZone" AllowDrop="True" DragOver="PackageDragOver" Drop="PackageDropped" DragLeave="PackageDragLeave" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="#51CEBD" BorderThickness="2" CornerRadius="12" Padding="24" MinHeight="118">
                            <Grid x:Name="DropLayout" ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="#51CEBD"/><TextBlock x:Name="DropFileLabel" Grid.Column="1" Text="{Binding PackageFileLabel}" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding PackageFile}"/><Button x:Name="ChoosePackageButton" Grid.Column="2" Content="Choose file" Command="{Binding PickPackageCommand}" VerticalAlignment="Center"/></Grid>
                        </Border>
                        <Grid x:Name="ProjectFields" ColumnSpacing="18" RowSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox Header="Project name" PlaceholderText="Generated from the file name" Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox x:Name="PlatformSelector" Grid.Column="1" Header="Platform" ItemsSource="{Binding PlatformOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding BuildTarget, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <TextBlock Text="{Binding DestinationPreview}" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DestinationPreview}"/>
                        <Grid x:Name="PresetFields" ColumnSpacing="12" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ComboBox Header="Preset" ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetChoice}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" HorizontalAlignment="Stretch"/><Button x:Name="CustomizePackagesButton" Grid.Column="1" Content="Customize packages" Command="{Binding CustomizeCreationPackagesCommand}" VerticalAlignment="Bottom"/></Grid>
                        <Button Content="Review and create" Command="{Binding CreateProjectCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Right"/>
                        <Expander Header="Templates and file path" HorizontalAlignment="Stretch"><StackPanel Spacing="16"><ComboBox Header="Template" ItemsSource="{Binding Recipes}" ItemTemplate="{StaticResource PresetChoice}" SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}" HorizontalAlignment="Stretch"/><TextBox Header="UnityPackage path" Text="{Binding PackageFile, Mode=TwoWay}"/><Button Content="Save as template" Command="{Binding SaveRecipeCommand}"/></StackPanel></Expander>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="WorkspaceView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="12" Margin="0,0,0,22"><Button Content="‹ Projects" Command="{Binding BackToProjectsCommand}" Style="{StaticResource QuietButton}"/><TextBlock Text="{Binding WorkspaceTitle}" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox PlaceholderText="Filter project packages" Text="{Binding PackageFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter project packages"/><Button Grid.Column="1" Content="Add package" Command="{Binding OpenProjectCatalogCommand}" Style="{StaticResource ActionButton}"/></Grid>
                    <Grid Grid.Row="2" Padding="14,4" ColumnSpacing="16" Opacity="0.6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="Package"/><TextBlock Grid.Column="1" Text="Installed"/></Grid>
                    <ListView x:Name="WorkspacePackages" Grid.Row="3" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage, Mode=TwoWay}">
                        <ListView.ItemTemplate><DataTemplate><Grid Padding="14,12" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Id}"/><TextBlock Text="{Binding Converter={StaticResource PackageRow}, ConverterParameter=Pending}" Visibility="{Binding Converter={StaticResource PackageRow}, ConverterParameter=PendingVisibility}" FontSize="12" Foreground="#51CEBD" TextWrapping="Wrap"/></StackPanel>
                            <local:PackageVersionSelector Grid.Column="1" PackageId="{Binding Id}" Value="{Binding SelectedVersion}" DisplayVersion="{Binding InstalledVersion}" Loaded="VersionSelectorLoaded" VersionPicked="WorkspaceVersionPicked" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="Installed package version"/>
                            <Button Grid.Column="2" Click="WorkspaceToggleClicked" Style="{StaticResource QuietButton}" IsEnabled="{Binding Converter={StaticResource PackageRow}, ConverterParameter=CanRemove}" ToolTipService.ToolTip="{Binding Converter={StaticResource PackageRow}, ConverterParameter=Action}" AutomationProperties.Name="{Binding Converter={StaticResource PackageRow}, ConverterParameter=Action}"><FontIcon Glyph="{Binding Converter={StaticResource PackageRow}, ConverterParameter=Glyph}" FontSize="14"/></Button>
                        </Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="4" ColumnSpacing="12" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Open in Unity" Command="{Binding OpenUnityCommand}" Style="{StaticResource QuietButton}"/><TextBlock Grid.Column="1" Text="{Binding WorkspaceChangeContext}" Visibility="{Binding WorkspaceChangesVisibility}" VerticalAlignment="Center" Opacity="0.65"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" Visibility="{Binding WorkspaceChangesVisibility}"><Button Content="Revert" Command="{Binding UndoChangesCommand}"/><Button Content="Apply changes" Command="{Binding ApplyChangesCommand}" Style="{StaticResource ActionButton}"/></StackPanel></Grid>
                </Grid>

                <Grid x:Name="CatalogView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="12" Margin="0,0,0,20"><Button Content="‹ Back to project" Command="{Binding BackToProjectCommand}" Style="{StaticResource QuietButton}"/><TextBlock Text="{Binding WorkspaceTitle}" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel>
                    <local:PackageBrowserView Grid.Row="1"/>
                </Grid>

                <Grid x:Name="PresetsView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Visibility="{Binding PresetHeaderVisibility}" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox x:Name="PresetSelector" ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetChoice}" SelectedItem="{Binding EditingPreset, Mode=TwoWay}" Width="230" FontSize="18" AutomationProperties.Name="Selected preset"/>
                            <Button Style="{StaticResource QuietButton}" AutomationProperties.Name="Preset options" ToolTipService.ToolTip="Preset options"><FontIcon Glyph="&#xE712;" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="New preset" Icon="Add" Command="{Binding CreatePresetCommand}"/><MenuFlyoutItem Text="Rename" Icon="Edit" Command="{Binding RenamePresetCommand}" IsEnabled="{Binding IsCustomPreset}"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Delete preset" Icon="Delete" Command="{Binding DeletePresetCommand}" IsEnabled="{Binding IsCustomPreset}"/></MenuFlyout></Button.Flyout></Button>
                        </StackPanel>
                    </Grid>
                    <Pivot x:Name="PackageTabs" Grid.Row="1" SelectedIndex="{Binding PackageTabIndex, Mode=TwoWay}">
                        <PivotItem x:Name="PresetTab" Header="Preset packages"><ListView x:Name="PresetPackageList" ItemsSource="{Binding PresetPackages}" SelectionMode="None">
                            <ListView.ItemTemplate><DataTemplate><Grid Padding="14,14" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE735;" Foreground="Gold" FontSize="12" Visibility="{Binding FavoriteVisibility}"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Id}"/></Grid>
                                <local:PackageVersionSelector Grid.Column="1" PackageId="{Binding Id}" Value="{Binding Version}" Loaded="VersionSelectorLoaded" VersionPicked="PresetVersionPicked" VerticalAlignment="Center" AutomationProperties.Name="Preset package version"/>
                                <Button Grid.Column="2" Style="{StaticResource QuietButton}" VerticalAlignment="Center" AutomationProperties.Name="Package options"><FontIcon Glyph="&#xE712;" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{Binding FavoriteAction}" Click="PackageStarClicked"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Remove from preset" Icon="Remove" Click="PresetRemoveClicked" IsEnabled="{Binding CanRemove}"/></MenuFlyout></Button.Flyout></Button>
                            </Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView></PivotItem>
                        <PivotItem x:Name="LibraryTab" Header="My packages"><local:PackageBrowserView/></PivotItem>
                    </Pivot>
                    <Border Grid.Row="2" Visibility="{Binding PresetChangesVisibility}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,12" Margin="0,16,0,0"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PresetSaveContext}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Discard" Command="{Binding DiscardPresetChangesCommand}" Style="{StaticResource QuietButton}"/><Button Grid.Column="2" Content="Save changes" Command="{Binding SaveEditedPresetCommand}" Style="{StaticResource ActionButton}"/></Grid></Border>
                </Grid>

                <Grid x:Name="ActivityView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16"><TextBlock Text="Activity" Style="{StaticResource TitleTextBlockStyle}"/><Button HorizontalAlignment="Right" Style="{StaticResource QuietButton}" AutomationProperties.Name="Project activity actions"><FontIcon Glyph="&#xE712;" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Open logs" Icon="Folder" Command="{Binding OpenLogsCommand}"/><MenuFlyoutItem Text="Unfinished projects" Icon="Repair" Command="{Binding RecoverProjectCommand}"/><MenuFlyoutItem Text="Restore project" Icon="Undo" Command="{Binding RestoreBackupCommand}"/></MenuFlyout></Button.Flyout></Button></Grid>
                    <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Visibility="{Binding DeveloperVisibility}" Margin="0,0,0,12"><AppBarButton Label="Diagnostic files" Icon="Folder" Command="{Binding OpenDiagnosticsCommand}"/><AppBarButton Label="Operation report" Icon="Document" Command="{Binding OpenReportCommand}"/></CommandBar>
                    <StackPanel Grid.Row="2" Visibility="{Binding ActivityEmptyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"><FontIcon Glyph="&#xE81C;" FontSize="36" Opacity="0.45"/><TextBlock Text="No recent activity" Opacity="0.65"/></StackPanel>
                    <ListView Grid.Row="2" ItemsSource="{Binding Activity}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="14,16" ColumnSpacing="20" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Opacity="0.55"/><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding Phase}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.8"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                </Grid>

                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="SettingsForm" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel Spacing="20">
                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="124"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Unity Editor" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding UnityEditorPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Select Unity.exe" AutomationProperties.Name="Unity Editor"/><Button Grid.Column="2" Content="Choose" Command="{Binding PickEditorCommand}"/></Grid>
                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="124"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Projects folder" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ProjectsRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Projects folder"/><Button Grid.Column="2" Content="Browse" Command="{Binding PickProjectsRootCommand}"/></Grid>
                        </StackPanel></Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions><TextBlock Text="Appearance" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Appearance"/></Grid></Border>
                        <Expander Header="Naming" HorizontalAlignment="Stretch"><StackPanel Spacing="14"><TextBox Header="Prefix" Text="{Binding NamingPrefix, Mode=TwoWay}"/><TextBox Header="Suffix" Text="{Binding NamingSuffix, Mode=TwoWay}"/><TextBox Header="Cleanup regex rules (one per line)" Text="{Binding NamingPatterns, Mode=TwoWay}" AcceptsReturn="True" MinHeight="80"/><CheckBox Content="Remember UnityPackage names" IsChecked="{Binding RememberNames, Mode=TwoWay}"/></StackPanel></Expander>
                        <Expander Header="Additional imports" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBox Header="UnityPackages folder" Text="{Binding ExtraImportsFolder, Mode=TwoWay}"/><Button Content="Browse" Command="{Binding PickExtraFolderCommand}"/></StackPanel></Expander>
                        <Expander Header="Developer tools"><StackPanel Spacing="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Developer mode" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{Binding DeveloperMode, Mode=TwoWay}" AutomationProperties.Name="Developer mode"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Verbose diagnostics" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{Binding VerboseDiagnostics, Mode=TwoWay}" AutomationProperties.Name="Verbose diagnostics"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Record tool output" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{Binding TraceTools, Mode=TwoWay}" AutomationProperties.Name="Record tool output"/></Grid><Button Content="Open diagnostic files" Command="{Binding OpenDiagnosticsCommand}"/><Button Content="Reload saved settings" Command="{Binding ReloadSettingsCommand}"/></StackPanel></Expander>
                        <Expander Header="Application"><StackPanel Spacing="12"><Button Content="Import legacy settings" Command="{Binding ImportSettingsCommand}"/><Button Content="Repair installation" Command="{Binding RepairInstallationCommand}"/><Button Content="Reset settings" Command="{Binding ResetSettingsCommand}"/><Button Content="Uninstall" Command="{Binding UninstallApplicationCommand}"/></StackPanel></Expander>
                        <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <Border Grid.Row="2" Visibility="{Binding WorkVisibility}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing Width="18" Height="18" IsActive="{Binding IsBusy}"/><TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Button Grid.Column="1" Content="Activity" Click="ActivityClicked"/><Button Grid.Column="3" Content="Stop" Command="{Binding CancelOperationCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Page>

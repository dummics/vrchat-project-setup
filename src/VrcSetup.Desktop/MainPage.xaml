<Page
    x:Class="VrcSetup_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VrcSetup_Desktop">
    <Page.Resources>
        <local:DisplayLabelConverter x:Key="DisplayLabel"/>
        <local:PackageRowConverter x:Key="PackageRow"/>
        <local:ProjectAttentionConverter x:Key="ProjectAttention"/>
        <local:ProjectDateConverter x:Key="ProjectDate"/>
        <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="48"/></Style>
        <Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style TargetType="Expander"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style x:Key="QuietButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}"/>
        <DataTemplate x:Key="PresetChoice"><TextBlock Text="{Binding Converter={StaticResource DisplayLabel}}"/></DataTemplate>
        <DataTemplate x:Key="HistoryEntryTemplate">
            <Expander IsExpanded="{Binding Expanded, Mode=TwoWay}" Margin="0,0,0,6" Background="Transparent" BorderThickness="0,0,0,1">
                <Expander.Header><StackPanel Spacing="4"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding State}" FontSize="12" Opacity="0.7"/></Grid><TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/><TextBlock Text="{Binding Date}" FontSize="11" Opacity="0.55"/></StackPanel></Expander.Header>
                <StackPanel Spacing="12"><TextBlock Text="{Binding Result}" Visibility="{Binding ResultVisibility}" TextWrapping="Wrap"/><TextBlock Text="{Binding Health}" Visibility="{Binding HealthVisibility}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource AppSecondaryBrush}"/>
                    <TextBlock Text="{Binding Packages}" Visibility="{Binding PackagesVisibility}" TextWrapping="Wrap" FontSize="13"/>
                    <Expander Header="Planned changes" Visibility="{Binding ChangesVisibility}" Background="Transparent" BorderThickness="0"><TextBlock Text="{Binding Changes}" TextWrapping="Wrap" FontSize="13"/></Expander>
                    <Expander Header="File locations" Background="Transparent" BorderThickness="0"><TextBlock Text="{Binding Paths}" FontSize="12" Foreground="{ThemeResource AppSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding ImportActionsVisibility}"><Button Content="Check project" Click="HistoryCheckClicked" IsEnabled="{Binding CanCheck}" Style="{StaticResource QuietButton}" FontSize="12" Padding="8,4" MinHeight="28"/><Button Content="{Binding RepairLabel}" Click="HistoryRepairClicked" IsEnabled="{Binding CanCheck}" Style="{StaticResource QuietButton}" FontSize="12" Padding="8,4" MinHeight="28"/></StackPanel>
                    <Button Content="Restore backup" Click="HistoryRestoreClicked" Visibility="{Binding RestoreVisibility}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" FontSize="12" Padding="8,4" MinHeight="28"/>
                    <Button Content="Open log" Click="HistoryLogClicked" IsEnabled="{Binding HasLog}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" FontSize="12" Padding="8,4" MinHeight="28"/></StackPanel>
            </Expander>
        </DataTemplate>
    </Page.Resources>
    <Grid Background="{ThemeResource AppCanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <InfoBar IsOpen="{Binding IsErrorVisible}" Message="{Binding ErrorMessage}" Title="" Severity="Error" IsClosable="True" Closed="ErrorClosed" Margin="12,8"/>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsEnabled="{Binding MainInteractionEnabled}" IsBackButtonVisible="Collapsed" PaneDisplayMode="Auto" OpenPaneLength="220" ExpandedModeThresholdWidth="1000" CompactModeThresholdWidth="640"
                        IsSettingsVisible="True" ItemInvoked="NavigationInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Projects" Tag="Projects" Icon="Library"/>
                <NavigationViewItem Content="Import projects" Tag="Create" Icon="Add"/>
                <NavigationViewItem Content="Packages" Tag="Presets" Icon="AllApps"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems><NavigationViewItem Content="Activity" Tag="Activity" Icon="Clock"/></NavigationView.FooterMenuItems>
            <Grid x:Name="PageContent" Padding="24,20" Background="{ThemeResource AppCanvasBrush}">
                <Grid x:Name="ProjectsView">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid x:Name="ProjectsHeader" ColumnSpacing="12" RowSpacing="12" Margin="0,0,0,16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Projects" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/><Button Command="{Binding OpenProjectsFolderCommand}" Style="{StaticResource QuietButton}" ToolTipService.ToolTip="Open projects folder" AutomationProperties.Name="Open projects folder"><FontIcon Glyph="&#xE8B7;" FontSize="16"/></Button></StackPanel>
                        <StackPanel x:Name="ProjectHeaderActions" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"><Button Content="Add existing" Command="{Binding PickExistingProjectCommand}"/><Button Content="New project" Style="{StaticResource ActionButton}" Click="NewProjectClicked"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="Search projects" Text="{Binding ProjectFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search projects"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding ProjectSort, Mode=TwoWay}" SelectionChanged="SortChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Project sort order"/>
                        <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshProjectsCommand}"/>
                    </Grid>
                    <ListView x:Name="ProjectList" Grid.Row="2" ItemsSource="{Binding Projects}" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" SelectionChanged="ProjectsSelected">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="56"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Margin" Value="0,2"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate>
                            <Grid Padding="14,12" ColumnSpacing="16" RowSpacing="8" Loaded="ProjectRowLoaded" SizeChanged="ProjectRowSizeChanged" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <StackPanel x:Name="ProjectModified" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding LastUpdatedUtc, Converter={StaticResource ProjectDate}, ConverterParameter=Full}" AutomationProperties.Name="{Binding LastUpdatedUtc, Converter={StaticResource ProjectDate}, ConverterParameter=Full}"><FontIcon Glyph="&#xE787;" FontSize="12" Opacity="0.55"/><TextBlock Text="{Binding LastUpdatedUtc, Converter={StaticResource ProjectDate}}" FontSize="12" Opacity="0.7"/></StackPanel>
                                <StackPanel x:Name="ProjectActions" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="#E8B55B" Visibility="{Binding Converter={StaticResource ProjectAttention}}" ToolTipService.ToolTip="{Binding Converter={StaticResource ProjectAttention}, ConverterParameter=Label}" AutomationProperties.Name="{Binding Converter={StaticResource ProjectAttention}, ConverterParameter=Label}"/><Button Content="Open project" Click="ProjectOpenClicked" Padding="12,6"/><Button Click="ProjectPackagesClicked" Style="{StaticResource QuietButton}" ToolTipService.ToolTip="Manage packages" AutomationProperties.Name="Manage project packages"><FontIcon Glyph="&#xE7B8;" FontSize="18"/></Button></StackPanel>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Visibility="{Binding EmptyProjectsVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="460"><FontIcon Glyph="&#xE8B7;" FontSize="40" Opacity="0.55"/><TextBlock Text="{Binding EmptyProjectsMessage}" TextWrapping="Wrap" TextAlignment="Center"/><Button Content="Choose projects folder" Command="{Binding PickProjectsRootCommand}" HorizontalAlignment="Center"/></StackPanel>
                    <ProgressRing Grid.Row="2" IsActive="{Binding IsLoadingProjects}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Row="3" Content="{Binding ManageSelectionLabel}" IsEnabled="{Binding HasSelectedProjects}" Command="{Binding OpenSelectedProjectsCommand}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
                </Grid>

                <ScrollViewer x:Name="CreateView" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AllowDrop="True" DragOver="PackageDragOver" Drop="ImportFilesDropped">
                    <Grid x:Name="CreateLayout" RowSpacing="16" HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="CreateForm" Grid.Row="1" HorizontalAlignment="Left" Spacing="16">
                        <Border x:Name="PackageDropZone" AllowDrop="True" DragOver="PackageDragOver" Drop="PackageDropped" DragLeave="PackageDragLeave" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20" MinHeight="92">
                            <Grid x:Name="DropLayout" ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="#51CEBD"/><TextBlock x:Name="DropFileLabel" Grid.Column="1" Text="{Binding PackageFileLabel}" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding PackageFile}"/><Button x:Name="ChoosePackageButton" Grid.Column="2" Content="Choose files" Click="ImportFilesClicked" VerticalAlignment="Center"/></Grid>
                        </Border>
                        <StackPanel Visibility="{Binding EditorSetupVisibility}" Spacing="6"><TextBlock Text="Unity 2022.3.22f1 is required" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Find Unity" Command="{Binding FindEditorCommand}"/><Button Content="Install Unity" Command="{Binding OpenUnityDownloadCommand}" Style="{StaticResource QuietButton}"/></StackPanel></StackPanel><ListView ItemsSource="{Binding ImportDrafts}" SelectedItem="{Binding SelectedImportDraft, Mode=TwoWay}" SelectionMode="Single" Visibility="{Binding DraftListVisibility}" MaxHeight="160" HorizontalAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" Padding="8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding File}"/><Button Grid.Column="1" Style="{StaticResource QuietButton}" Click="RemoveImportDraftClicked" AutomationProperties.Name="Remove selected file"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                        <Grid x:Name="ProjectFields" MaxWidth="620" HorizontalAlignment="Left" ColumnSpacing="12" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox Header="Project name" PlaceholderText="Generated from the file name" Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox x:Name="PlatformSelector" Grid.Column="1" Header="Platform" ItemsSource="{Binding PlatformOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding BuildTarget, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <TextBlock Text="{Binding DestinationPreview}" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DestinationPreview}"/>
                        <Grid x:Name="PackageSetup" ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid x:Name="PresetFields" HorizontalAlignment="Left" ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ComboBox x:Name="CreationPresetSelector" Header="Preset" ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetChoice}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" HorizontalAlignment="Stretch"/><Button x:Name="CustomizePackagesButton" Grid.Column="1" Content="Customize" ToolTipService.ToolTip="Customize packages for this import" Command="{Binding CustomizeCreationPackagesCommand}" VerticalAlignment="Bottom"/></Grid>
                            <StackPanel x:Name="ReviewAction" Grid.Column="1" HorizontalAlignment="Right" Spacing="6" MaxWidth="260" VerticalAlignment="Bottom"><TextBlock Text="{Binding ImportError}" Height="36" MaxLines="2" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SystemFillColorCriticalBrush}" ToolTipService.ToolTip="{Binding ImportError}"/><Button Content="Settings" Click="ImportSettingsClicked" Style="{StaticResource QuietButton}" Visibility="{Binding ImportSettingsVisibility}" HorizontalAlignment="Right"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><ProgressRing Width="18" Height="18" IsActive="{Binding IsPreparingImport}" Visibility="{Binding ImportPreparingVisibility}"/><Button Content="{Binding ImportReviewLabel}" Command="{Binding CreateProjectCommand}" Style="{StaticResource ActionButton}"/></StackPanel></StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CreationPackageSummary}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding InspectionStatus}"/><Button Grid.Column="1" Style="{StaticResource QuietButton}" AutomationProperties.Name="Package analysis options" MinHeight="28" Padding="8,4"><FontIcon Glyph="&#xE712;" FontSize="12"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Inspect further" Command="{Binding InspectDeeperCommand}" IsEnabled="{Binding CanInspectDeeper}"/></MenuFlyout></Button.Flyout></Button></Grid>
                                <GridView x:Name="CreationPackageList" ItemsSource="{Binding CreationPackages}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="184" Loaded="CreationPackagesLoaded" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemHeight="44"/></ItemsPanelTemplate></GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinWidth" Value="0"/></Style></GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" Padding="0,4,12,4" ToolTipService.ToolTip="{Binding Tooltip}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Hint}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="11" Opacity="0.65" MaxWidth="100" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="2" Content="{Binding Action}" Visibility="{Binding ActionVisibility}" Click="AddCreationSuggestionClicked" Style="{StaticResource QuietButton}" FontSize="12" MinHeight="28" Padding="8,4" VerticalAlignment="Center"/></Grid></DataTemplate></GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </Grid>
                        <TextBox Header="UnityPackage path" Text="{Binding PackageFile, Mode=TwoWay}" Visibility="{Binding ManualImportPathVisibility}"/>
                    </StackPanel>
                    <StackPanel x:Name="ImportQueueSection" Spacing="12" HorizontalAlignment="Left">
                        <Grid ColumnSpacing="12" RowSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Import projects" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/><TextBlock x:Name="ImportResourceSummary" Grid.Column="1" Text="{Binding ResourceSummary}" FontSize="12" Opacity="0.65" HorizontalAlignment="Right" VerticalAlignment="Center"/><Button Grid.Column="2" Style="{StaticResource QuietButton}" AutomationProperties.Name="Import options"><FontIcon Glyph="&#xE712;"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Open logs" Command="{Binding OpenLogsCommand}"/><MenuFlyoutItem Text="Open project folders" Command="{Binding OpenProjectsFolderCommand}"/></MenuFlyout></Button.Flyout></Button></Grid>
                        <Grid Height="28" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MemoryWarning}" VerticalAlignment="Center" Foreground="#E8B55B" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding MemoryWarning}"/><Button Grid.Column="1" Command="{Binding ClearImportHistoryCommand}" IsEnabled="{Binding CanClearCompletedImports}" Style="{StaticResource QuietButton}" MinHeight="28" Padding="8,4" ToolTipService.ToolTip="Hide completed imports; keep their Activity history"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="10"/><TextBlock Text="Clear completed" FontSize="12"/></StackPanel></Button></Grid>
                        <TextBlock Text="No imports yet" Visibility="{Binding ImportsEmptyVisibility}" FontSize="12" Foreground="{ThemeResource AppSecondaryBrush}"/>
                        <ListView x:Name="ImportQueueList" ItemsSource="{Binding ImportJobs}" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                <Expander IsExpanded="{Binding DetailsOpen, Mode=TwoWay}" Expanding="ImportDetailsExpanded" Collapsed="ImportDetailsCollapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                                    <Expander.Header><Grid RowSpacing="10" ColumnSpacing="12" Padding="0,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Elapsed}" Opacity="0.65" FontSize="12" ToolTipService.ToolTip="Elapsed time" HorizontalAlignment="Right"/><ProgressBar Grid.Row="1" Value="{Binding Progress}" Maximum="100" Height="6" VerticalAlignment="Center" AutomationProperties.Name="Import step progress"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Step}" FontSize="12" Opacity="0.65" VerticalAlignment="Center"/></Grid></Expander.Header>
                                    <StackPanel Spacing="10"><TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Message}" FontSize="12" MaxLines="3" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" MinHeight="120" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Import console output"/>
                                        <Grid HorizontalAlignment="Right"><Button Content="Resume" Click="ImportRecoverClicked" Visibility="{Binding RecoverVisibility}" Style="{StaticResource QuietButton}"/><Button Content="Cancel import" Click="ImportCancelClicked" Visibility="{Binding CancelVisibility}" IsEnabled="{Binding CanCancel}" Style="{StaticResource QuietButton}"/></Grid>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </DataTemplate></ListView.ItemTemplate></ListView>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="WorkspaceView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="8" Margin="0,0,0,16"><Button Content="‹ Projects" Command="{Binding BackToProjectsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding WorkspaceTitle}" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Open project" Command="{Binding OpenUnityCommand}" Visibility="{Binding SingleProjectLaunchVisibility}" Padding="12,6"/></Grid></StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox PlaceholderText="Filter project packages" Text="{Binding PackageFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter project packages"/><Button Grid.Column="1" Content="Add package" Command="{Binding OpenProjectCatalogCommand}" Style="{StaticResource ActionButton}"/></Grid>
                    <Grid Grid.Row="2" Padding="14,8" ColumnSpacing="16" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="Package" FontSize="12" Opacity="0.65"/><TextBlock Grid.Column="1" Text="Installed version" FontSize="12" Opacity="0.65"/></Grid>
                    <ListView x:Name="WorkspacePackages" Grid.Row="3" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage, Mode=TwoWay}">
                        <ListView.ItemTemplate><DataTemplate><Grid Padding="14,12" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7B8;" FontSize="17" Opacity="0.65" VerticalAlignment="Top" Margin="0,2,0,0"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Id}" FontSize="11" Foreground="{ThemeResource AppSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Id}"/><TextBlock Text="{Binding Converter={StaticResource PackageRow}, ConverterParameter=Pending}" Visibility="{Binding Converter={StaticResource PackageRow}, ConverterParameter=PendingVisibility}" FontSize="12" Foreground="{ThemeResource AppAccentTextBrush}" TextWrapping="Wrap"/></StackPanel></Grid>
                            <local:PackageVersionSelector Grid.Column="1" PackageId="{Binding Id}" Value="{Binding SelectedVersion}" DisplayVersion="{Binding InstalledVersion}" Loaded="VersionSelectorLoaded" VersionPicked="WorkspaceVersionPicked" Background="Transparent" BorderThickness="0" Padding="8,6" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="Installed package version"/>
                            <Button Grid.Column="2" Click="WorkspaceToggleClicked" Style="{StaticResource QuietButton}" IsEnabled="{Binding Converter={StaticResource PackageRow}, ConverterParameter=CanRemove}" ToolTipService.ToolTip="{Binding Converter={StaticResource PackageRow}, ConverterParameter=Action}" AutomationProperties.Name="{Binding Converter={StaticResource PackageRow}, ConverterParameter=Action}"><Grid Width="20" Height="20"><Ellipse Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.2"/><TextBlock Text="{Binding Converter={StaticResource PackageRow}, ConverterParameter=Glyph}" FontSize="16" LineHeight="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
                        </Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="4" Spacing="8" Margin="0,18,0,0" Visibility="{Binding WorkspaceChangesVisibility}"><TextBlock Text="{Binding WorkspaceChangeContext}" TextTrimming="CharacterEllipsis" Opacity="0.65"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button Content="Revert" Command="{Binding UndoChangesCommand}"/><Button Content="Apply changes" Command="{Binding ApplyChangesCommand}" Style="{StaticResource ActionButton}"/></StackPanel></StackPanel>
                </Grid>

                <Grid x:Name="CatalogView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="12" Margin="0,0,0,20"><Button Content="‹ Back to project" Command="{Binding BackToProjectCommand}" Style="{StaticResource QuietButton}"/><TextBlock Text="{Binding WorkspaceTitle}" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel>
                    <local:PackageBrowserView Grid.Row="1"/>
                </Grid>

                <Grid x:Name="PresetsView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Visibility="{Binding PresetHeaderVisibility}" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox x:Name="PresetSelector" ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetChoice}" SelectedItem="{Binding EditingPreset, Mode=TwoWay}" Width="230" FontSize="14" AutomationProperties.Name="Selected preset"/>
                            <Button Style="{StaticResource QuietButton}" AutomationProperties.Name="Preset options" ToolTipService.ToolTip="Preset options"><FontIcon Glyph="&#xE712;" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="New preset" Icon="Add" Command="{Binding CreatePresetCommand}"/><MenuFlyoutItem Text="Rename" Icon="Edit" Command="{Binding RenamePresetCommand}" IsEnabled="{Binding IsCustomPreset}"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Delete preset" Icon="Delete" Command="{Binding DeletePresetCommand}" IsEnabled="{Binding IsCustomPreset}"/></MenuFlyout></Button.Flyout></Button>
                        </StackPanel>
                    </Grid>
                    <Pivot x:Name="PackageTabs" Grid.Row="1" SelectedIndex="{Binding PackageTabIndex, Mode=TwoWay}">
                        <PivotItem x:Name="PresetTab" Header="Preset packages"><ListView x:Name="PresetPackageList" ItemsSource="{Binding PresetPackages}" SelectionMode="None">
                            <ListView.ItemTemplate><DataTemplate><Grid Padding="12,8" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE735;" Foreground="Gold" FontSize="12" Visibility="{Binding FavoriteVisibility}"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Id}"/></Grid>
                                <local:PackageVersionSelector Grid.Column="1" PackageId="{Binding Id}" Value="{Binding Version}" Loaded="VersionSelectorLoaded" VersionPicked="PresetVersionPicked" VerticalAlignment="Center" AutomationProperties.Name="Preset package version"/>
                                <Button Grid.Column="2" Style="{StaticResource QuietButton}" VerticalAlignment="Center" AutomationProperties.Name="Package options"><FontIcon Glyph="&#xE712;" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{Binding FavoriteAction}" Click="PackageStarClicked"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Remove from preset" Icon="Remove" Click="PresetRemoveClicked" IsEnabled="{Binding CanRemove}"/></MenuFlyout></Button.Flyout></Button>
                            </Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView></PivotItem>
                        <PivotItem x:Name="LibraryTab" Header="My packages"><local:PackageBrowserView/></PivotItem>
                    </Pivot>
                    <Border Grid.Row="2" Visibility="{Binding PresetChangesVisibility}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,12" Margin="0,16,0,0"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PresetSaveContext}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Discard" Command="{Binding DiscardPresetChangesCommand}" Style="{StaticResource QuietButton}"/><Button Grid.Column="2" Content="Save changes" Command="{Binding SaveEditedPresetCommand}" Style="{StaticResource ActionButton}"/></Grid></Border>
                </Grid>

                <Grid x:Name="ActivityView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16"><TextBlock Text="Activity" Style="{StaticResource TitleTextBlockStyle}"/><Button Content="Open logs" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Command="{Binding OpenLogsCommand}"/></Grid>
                    <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Visibility="{Binding DeveloperVisibility}" Margin="0,0,0,12"><AppBarButton Label="Diagnostic files" Icon="Folder" Command="{Binding OpenDiagnosticsCommand}"/><AppBarButton Label="Operation report" Icon="Document" Command="{Binding OpenReportCommand}"/></CommandBar>
                    <Pivot x:Name="ActivityTabs" Grid.Row="2">
                        <PivotItem Header="Imports"><Grid><TextBlock Text="No import history yet" Visibility="{Binding ImportHistoryEmptyVisibility}" Opacity="0.6" Margin="0,20"/><ListView ItemsSource="{Binding ImportHistory}" SelectionMode="None" ItemTemplate="{StaticResource HistoryEntryTemplate}"/></Grid></PivotItem>
                        <PivotItem Header="Operations"><Grid><TextBlock Text="No operations yet" Visibility="{Binding OperationHistoryEmptyVisibility}" Opacity="0.6" Margin="0,20"/><ListView ItemsSource="{Binding OperationHistory}" SelectionMode="None" ItemTemplate="{StaticResource HistoryEntryTemplate}"/></Grid></PivotItem>
                        <PivotItem x:Name="DiagnosticsTab" Header="Diagnostics"><ListView ItemsSource="{Binding Activity}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="12" Spacing="4"><TextBlock Text="{Binding Time}" FontSize="11" Opacity="0.55"/><TextBlock Text="{Binding Phase}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></PivotItem>
                    </Pivot>
                </Grid>

                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="SettingsForm" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>
                        <StackPanel Spacing="8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding EditorVersionLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding EditorStatus}" Foreground="{ThemeResource AppAccentTextBrush}" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding EditorPathLabel}" Foreground="{ThemeResource AppSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding UnityEditorPath}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Find editor" Command="{Binding FindEditorCommand}"/><Button Content="Choose file" Command="{Binding PickEditorCommand}" Style="{StaticResource QuietButton}"/><Button Content="Install Unity" Command="{Binding OpenUnityDownloadCommand}" Style="{StaticResource QuietButton}"/></StackPanel></StackPanel>
                        <StackPanel Spacing="6"><TextBlock Text="Projects folder"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ProjectsRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Projects folder"/><Button Grid.Column="1" Content="Browse" Command="{Binding PickProjectsRootCommand}"/></Grid></StackPanel>
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Appearance" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Width="140" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme, Mode=TwoWay}" AutomationProperties.Name="Appearance"/></Grid>
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Show manual UnityPackage path" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{Binding ManualImportPath, Mode=TwoWay}" AutomationProperties.Name="Show manual UnityPackage path"/></Grid>
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Hide completed imports automatically" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{Binding AutoHideCompletedImports, Mode=TwoWay}" AutomationProperties.Name="Hide completed imports automatically"/></Grid>
                        <Expander Header="Naming" HorizontalAlignment="Stretch"><StackPanel Spacing="14"><TextBox Header="Prefix" Text="{Binding NamingPrefix, Mode=TwoWay}"/><TextBox Header="Suffix" Text="{Binding NamingSuffix, Mode=TwoWay}"/><TextBox Header="Cleanup regex rules (one per line)" Text="{Binding NamingPatterns, Mode=TwoWay}" AcceptsReturn="True" MinHeight="80"/><CheckBox Content="Remember UnityPackage names" IsChecked="{Binding RememberNames, Mode=TwoWay}"/></StackPanel></Expander>
                        <Expander Header="Additional imports" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBox Header="UnityPackages folder" Text="{Binding ExtraImportsFolder, Mode=TwoWay}"/><Button Content="Browse" Command="{Binding PickExtraFolderCommand}"/></StackPanel></Expander>
                        <Expander Header="Developer tools"><StackPanel Spacing="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Developer mode" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{Binding DeveloperMode, Mode=TwoWay}" AutomationProperties.Name="Developer mode"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Verbose diagnostics" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{Binding VerboseDiagnostics, Mode=TwoWay}" AutomationProperties.Name="Verbose diagnostics"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Record tool output" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsOn="{Binding TraceTools, Mode=TwoWay}" AutomationProperties.Name="Record tool output"/></Grid><Button Content="Open diagnostic files" Command="{Binding OpenDiagnosticsCommand}"/><Button Content="Reload saved settings" Command="{Binding ReloadSettingsCommand}"/></StackPanel></Expander>
                        <Expander Header="Updates"><StackPanel Spacing="12"><CheckBox Content="Check for updates on startup" IsChecked="{Binding CheckUpdatesOnStartup, Mode=TwoWay}"/><CheckBox Content="Include beta releases" IsChecked="{Binding IncludeBetaUpdates, Mode=TwoWay}"/><Button Content="Check for updates" Command="{Binding CheckApplicationUpdatesCommand}"/><Button Content="Report a bug on GitHub" Command="{Binding ReportBugCommand}"/></StackPanel></Expander>
                        <Expander Header="Application"><StackPanel Spacing="12"><Button Content="Import legacy settings" Command="{Binding ImportSettingsCommand}"/><Button Content="Clear analysis cache" Command="{Binding ClearImportCacheCommand}"/><Button Content="Repair installation" Command="{Binding RepairInstallationCommand}"/><Button Content="Reset settings" Command="{Binding ResetSettingsCommand}"/><Button Content="Uninstall" Command="{Binding UninstallApplicationCommand}"/></StackPanel></Expander>
                        <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <Border Grid.Row="2" Visibility="{Binding WorkVisibility}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing Width="18" Height="18" IsActive="{Binding IsBusy}"/><TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Button Grid.Column="1" Content="Activity" Click="ActivityClicked"/><Button Grid.Column="3" Content="Stop" Command="{Binding CancelOperationCommand}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Background="{ThemeResource AppCanvasBrush}" Padding="12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Foreground="{ThemeResource AppSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding UpdateStatus}"/>
            <Button x:Name="ApplicationVersionButton" Grid.Column="1" Content="{Binding UpdateLabel}" IsEnabled="{Binding MainInteractionEnabled}" Style="{StaticResource QuietButton}" FontSize="11" Padding="8,2" MinHeight="28" AutomationProperties.Name="Application version and updates">
                <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Check for updates" Command="{Binding CheckApplicationUpdatesCommand}"/><MenuFlyoutItem Text="Install update and restart" Command="{Binding InstallApplicationUpdateCommand}" IsEnabled="{Binding HasApplicationUpdate}"/><MenuFlyoutItem Text="Releases and downloads" Command="{Binding OpenReleasesCommand}"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Report a bug" Command="{Binding ReportBugCommand}"/></MenuFlyout></Button.Flyout>
            </Button>
        </Grid>
        <Grid Grid.RowSpan="4" Background="#99000000" Visibility="{Binding ApplyOverlayVisibility}" AutomationProperties.Name="Applying package changes">
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="24" MaxWidth="460" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16"><TextBlock Text="Applying changes" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding ApplyProject}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding ApplyPosition}" FontSize="12" Opacity="0.65"/><ProgressBar IsIndeterminate="True" MinWidth="200"/><TextBlock Text="{Binding ApplyPhase}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><Button Content="Cancel" Command="{Binding CancelApplyCommand}" IsEnabled="{Binding CanCancelApply}" HorizontalAlignment="Right" Style="{StaticResource QuietButton}"/></StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="VrcSetup_Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VrcSetup_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="VrcSetup.Desktop"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource AppSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="0,0,0,1" x:Name="AppTitleBar" Title="VrcSetup.Desktop">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppMark.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
